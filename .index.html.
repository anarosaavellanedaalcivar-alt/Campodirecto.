<script>
// Navegación
function showPage(id){
 document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
 document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.page===id));
 const page=document.getElementById(id);
 if(page)page.classList.add("active");
 document.getElementById("sidebar").classList.remove("open");
 window.scrollTo({top:0,behavior:"smooth"});
}
document.querySelectorAll(".nav button").forEach(b=>b.addEventListener("click",()=>showPage(b.dataset.page)));
document.getElementById("today").textContent=new Date().toLocaleDateString("es-EC",{day:"numeric",month:"short",year:"numeric"});

// Datos iniciales de ejemplo
let inventory=JSON.parse(localStorage.getItem("cd_inventory")||"null")||[
 {name:"Papa súper chola",category:"Tubérculos",stock:1200,minimum:200,price:0.45,unit:"quintales"},
 {name:"Maíz amarillo",category:"Granos",stock:850,minimum:150,price:0.38,unit:"quintales"},
 {name:"Fréjol canario",category:"Legumbres",stock:500,minimum:100,price:0.90,unit:"quintales"},
 {name:"Cebolla colorada",category:"Hortalizas",stock:650,minimum:120,price:0.60,unit:"sacos"},
 {name:"Tomate de árbol",category:"Frutas",stock:250,minimum:100,price:0.70,unit:"cajas"}
];
let clients=JSON.parse(localStorage.getItem("cd_clients")||"null")||[
 {name:"Comercial Andina",country:"Ecuador",type:"Mayorista",interest:"Papa",status:"En seguimiento"},
 {name:"Distribuidora del Norte",country:"Ecuador",type:"Distribuidor",interest:"Maíz",status:"Cliente activo"},
 {name:"Importadora Global",country:"Colombia",type:"Importador",interest:"Fréjol",status:"Negociación"}
];
let orders=JSON.parse(localStorage.getItem("cd_orders")||"null")||[
 {customer:"Comercial Andina",product:"Papa súper chola",quantity:50,destination:"Tulcán"},
 {customer:"Distribuidora del Norte",product:"Maíz amarillo",quantity:30,destination:"Quito"}
];
let suppliers=JSON.parse(localStorage.getItem("cd_suppliers")||"null")||[
 {name:"Productores del Carchi",location:"Tulcán",product:"Papa",phone:"0990000000"},
 {name:"Asociación Agrícola",location:"Montúfar",product:"Fréjol",phone:"0990000001"}
];

function save(){
 localStorage.setItem("cd_inventory",JSON.stringify(inventory));
 localStorage.setItem("cd_clients",JSON.stringify(clients));
 localStorage.setItem("cd_orders",JSON.stringify(orders));
 localStorage.setItem("cd_suppliers",JSON.stringify(suppliers));
}

function renderInventory(){
 const total=inventory.reduce((a,p)=>a+Number(p.stock),0);
 const low=inventory.filter(p=>Number(p.stock)<=Number(p.minimum)).length;
 const value=inventory.reduce((a,p)=>a+Number(p.stock)*Number(p.price),0);
 document.getElementById("inventoryTable").innerHTML=inventory.map((p,i)=>`
 <tr><td>${escapeHTML(p.name)}</td><td>${escapeHTML(p.category)}</td><td>${p.stock} ${escapeHTML(p.unit||"unidades")}</td><td>${p.minimum}</td>
 <td><span class="status ${p.stock<=p.minimum?'danger':' '}">${p.stock<=p.minimum?'Stock bajo':'Disponible'}</span></td>
 <td><button class="secondary" onclick="deleteProduct(${i})">Eliminar</button></td></tr>`).join("");
 document.getElementById("invCount").textContent=inventory.length;
 document.getElementById("invUnits").textContent=total.toLocaleString("es-EC");
 document.getElementById("invLow").textContent=low;
 document.getElementById("invValue").textContent="$"+value.toFixed(2);
 document.getElementById("statProducts").textContent=inventory.length;
 document.getElementById("statStock").textContent=total.toLocaleString("es-EC");
 document.getElementById("reportProducts").textContent=inventory.length;
 document.getElementById("reportStock").textContent=total.toLocaleString("es-EC");
 document.getElementById("productTable").innerHTML=inventory.map(p=>`<tr><td>${escapeHTML(p.name)}</td><td>${escapeHTML(p.category)}</td><td>${escapeHTML(p.unit||"Unidades")}</td><td>${p.stock}</td><td><span class="status">Registrado</span></td></tr>`).join("");
 document.getElementById("orderProduct").innerHTML=inventory.map(p=>`<option>${escapeHTML(p.name)}</option>`).join("");
}
function deleteProduct(i){
 if(confirm("¿Deseas eliminar este producto?")){inventory.splice(i,1);save();renderAll()}
}
document.getElementById("newProduct").addEventListener("submit",e=>{
 e.preventDefault();const f=new FormData(e.target);
 inventory.push({
  name:f.get("name"),category:f.get("category"),stock:Number(f.get("stock")),
  minimum:Number(f.get("minimum")),price:Number(f.get("price")),unit:f.get("unit")||"unidades"
 });
 save();e.target.reset();renderAll();alert("Producto registrado correctamente.");
});
function renderClients(){
 document.getElementById("clientTable").innerHTML=clients.map(c=>`<tr><td>${escapeHTML(c.name)}</td><td>${escapeHTML(c.country)}</td><td>${escapeHTML(c.type)}</td><td>${escapeHTML(c.interest||"No indicado")}</td><td><span class="status">${escapeHTML(c.status)}</span></td></tr>`).join("");
 document.getElementById("crmCount").textContent=clients.length;
 document.getElementById("statClients").textContent=clients.length;
 document.getElementById("reportClients").textContent=clients.length;
}
document.getElementById("clientForm").addEventListener("submit",e=>{
 e.preventDefault();const f=new FormData(e.target);
 clients.push(Object.fromEntries(f.entries()));save();e.target.reset();renderAll();alert("Cliente agregado al CRM.");
});
function renderOrders(){
 document.getElementById("ordersTable").innerHTML=orders.map(o=>`<tr><td>${escapeHTML(o.customer)}</td><td>${escapeHTML(o.product)}</td><td>${o.quantity}</td><td>${escapeHTML(o.destination)}</td><td><span class="status warn">Por confirmar</span></td></tr>`).join("");
 document.getElementById("statOrders").textContent=orders.length;
 document.getElementById("reportOrders").textContent=orders.length;
}
document.getElementById("orderForm").addEventListener("submit",e=>{
 e.preventDefault();const f=new FormData(e.target);
 orders.push(Object.fromEntries(f.entries()));save();e.target.reset();renderAll();alert("Pedido registrado. Recuerda confirmar disponibilidad.");
});
function renderSuppliers(){
 document.getElementById("supplierTable").innerHTML=suppliers.map(s=>`<tr><td>${escapeHTML(s.name)}</td><td>${escapeHTML(s.location)}</td><td>${escapeHTML(s.product)}</td><td>${escapeHTML(s.phone)}</td></tr>`).join("");
}
document.getElementById("supplierForm").addEventListener("submit",e=>{
 e.preventDefault();const f=new FormData(e.target);
 suppliers.push(Object.fromEntries(f.entries()));save();e.target.reset();renderAll();alert("Productor registrado.");
});
function renderAll(){renderInventory();renderClients();renderOrders();renderSuppliers()}
function escapeHTML(value){
 return String(value??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}

// Simulador de gemelo digital
function simulate(){
 const moisture=Number(document.getElementById("moisture").value);
 const temp=Number(document.getElementById("temperature").value);
 const nutrient=Number(document.getElementById("nutrient").value);
 const moistureScore=100-Math.abs(moisture-65);
 const tempScore=100-Math.abs(temp-20)*3;
 const score=Math.round((moistureScore+Math.max(0,tempScore)+nutrient)/3);
 let status=score>=80?"Favorable":score>=60?"Moderado":"Requiere atención";
 let advice=moisture<40?"Revisar riego":moisture>85?"Verificar exceso de humedad":nutrient<40?"Evaluar nutrientes":"Monitorear";
 document.getElementById("moistureValue").textContent=moisture+"%";
 document.getElementById("temperatureValue").textContent=temp+" °C";
 document.getElementById("nutrientValue").textContent=nutrient+"%";
 document.getElementById("twinScore").textContent=score+" / 100";
 document.getElementById("twinStatus").textContent=status;
 document.getElementById("twinAdvice").textContent=advice;
 document.getElementById("twinMoisture").textContent=moisture+"%";
 document.getElementById("twinTemp").textContent=temp+"°";
 document.getElementById("twinNutrients").textContent=nutrient+"%";
 document.getElementById("twinScore2").textContent=score;
}
["moisture","temperature","nutrient"].forEach(id=>document.getElementById(id).addEventListener("input",simulate));

// Asistente local de respuestas de ejemplo
function chat(){
 const input=document.getElementById("chatInput");
 const q=input.value.trim();if(!q)return;
 const box=document.getElementById("chatMessages");
 let answer="Puedo ayudarte a organizar esta consulta. Revisa los módulos ERP, CRM y Gemelos Digitales para gestionar la información correspondiente.";
 const s=q.toLowerCase();
 if(s.includes("inventario")||s.includes("stock"))answer="En Inventario puedes registrar productos, controlar cantidades y revisar alertas de stock bajo.";
 else if(s.includes("cliente")||s.includes("crm"))answer="En el CRM registra compradores, país, tipo de cliente, producto de interés y estado de seguimiento.";
 else if(s.includes("cultivo")||s.includes("gemelo"))answer="En Gemelos Digitales puedes modificar humedad, temperatura y nutrientes para simular escenarios agrícolas.";
 else if(s.includes("pedido")||s.includes("venta"))answer="En Pedidos y ventas puedes registrar comprador, producto, cantidad y destino. Confirma disponibilidad antes de cerrar la operación.";
 box.innerHTML+="<br><br><b>Tu consulta:</b> "+escapeHTML(q)+"<br><br><b>CampoDirecto AI:</b> "+answer;
 input.value="";
}
document.getElementById("chatInput").addEventListener("keydown",e=>{if(e.key==="Enter")chat()});

// Exportación CSV
function exportCSV(){
 const rows=[["Producto","Categoría","Stock","Mínimo","Costo unitario","Unidad"],...inventory.map(p=>[p.name,p.category,p.stock,p.minimum,p.price,p.unit])];
 const csv=rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(",")).join("\n");
 const url=URL.createObjectURL(new Blob(["\ufeff"+csv],{type:"text/csv;charset=utf-8"}));
 const a=document.createElement("a");a.href=url;a.download="campodirecto-inventario.csv";a.click();URL.revokeObjectURL(url);
}
document.getElementById("globalSearch").addEventListener("keydown",e=>{
 if(e.key==="Enter"){
  const q=e.target.value.toLowerCase();
  const match=inventory.find(p=>p.name.toLowerCase().includes(q));
  if(match){showPage("inventory");}
  else if(clients.some(c=>c.name.toLowerCase().includes(q))){showPage("crm");}
  else alert("No encontramos coincidencias en los registros actuales.");
 }
});
renderAll();
simulate();
</script>
